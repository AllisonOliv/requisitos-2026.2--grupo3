@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Estudante" as Estudante
actor "Equipe do NEI" as NEI
actor "Coordenador de curso" as Coordenador
actor "Professor" as Professor
actor "Estudante estrangeiro
recebido" as Incoming
actor "Ex-intercambista" as Alumni
actor "Administrador
do sistema" as Admin

rectangle "ConectaGlobal" {
  usecase "Consultar oportunidades" as UC01
  usecase "Filtrar oportunidades" as UC02
  usecase "Consultar detalhes e requisitos" as UC03
  usecase "Realizar autoavaliação" as UC04
  usecase "Consultar recursos de preparação" as UC05
  usecase "Registrar candidatura" as UC06
  usecase "Organizar documentos" as UC07
  usecase "Acompanhar candidatura" as UC08
  usecase "Gerenciar oportunidades e editais" as UC09
  usecase "Gerenciar convênios e bolsas" as UC10
  usecase "Analisar candidaturas" as UC11
  usecase "Atualizar status" as UC12
  usecase "Gerenciar notificações" as UC13
  usecase "Consultar relatórios" as UC14
  usecase "Compartilhar relatos" as UC15
  usecase "Participar de mentoria" as UC16
  usecase "Participar de Tandem" as UC17
  usecase "Consultar eventos e fórum" as UC18
  usecase "Consultar recursos de integração" as UC19
  usecase "Gerenciar usuários e permissões" as UC20
}

Estudante --> UC01
Estudante --> UC02
Estudante --> UC03
Estudante --> UC04
Estudante --> UC05
Estudante --> UC06
Estudante --> UC07
Estudante --> UC08
NEI --> UC09
NEI --> UC10
NEI --> UC11
NEI --> UC12
NEI --> UC13
NEI --> UC14
Coordenador --> UC11
Coordenador --> UC08
Professor --> UC18
Incoming --> UC19
Incoming --> UC17
Alumni --> UC15
Alumni --> UC16
Alumni --> UC17
Estudante --> UC16
Estudante --> UC17
Estudante --> UC18
Admin --> UC20

UC06 .> UC07 : <<include>>
UC11 .> UC12 : <<include>>
@enduml

@startuml
skinparam componentStyle rectangle
skinparam shadowing false

package "ConectaGlobal" {
  [Interface Web/Mobile] as UI
  [Autenticação e Autorização] as AUTH
  [Serviço de Oportunidades] as OPORT
  [Serviço de Convênios e Bolsas] as CONV
  [Serviço de Elegibilidade] as ELEG
  [Serviço de Candidaturas] as CAND
  [Gestão de Documentos] as DOC
  [Serviço de Notificações] as NOTIF
  [Relatórios Gerenciais] as REL
  [Preparação e Conteúdos] as PREP
  [Módulo Colaborativo e Pós-intercâmbio] as COL
  database "Banco de Dados" as DB
}

UI --> AUTH
UI --> OPORT
UI --> ELEG
UI --> CAND
UI --> PREP
UI --> COL
OPORT --> CONV
CAND --> ELEG
CAND --> DOC
CAND --> NOTIF
CAND --> REL
OPORT --> DB
CONV --> DB
ELEG --> DB
CAND --> DB
DOC --> DB
NOTIF --> DB
REL --> DB
PREP --> DB
COL --> DB
@enduml

@startuml
skinparam shadowing false

node "Dispositivo do usuário
(Navegador / Aplicativo)" as CLIENT {
  artifact "Interface ConectaGlobal"
}

node "Ambiente de aplicação" as APP {
  artifact "Aplicação Web"
  artifact "API / Serviços de negócio"
}

database "Servidor de banco de dados" as DB

CLIENT --> APP : HTTPS
APP --> DB : Conexão segura
@enduml
