@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Estudante" as Estudante
actor "Equipe do NEI" as NEI
actor "Coordenador de curso" as Coordenador
actor "Professor" as Professor
actor "Estudante estrangeiro\nrecebido" as Incoming
actor "Ex-intercambista" as Alumni
actor "Administrador\ndo sistema" as Admin

rectangle "ConectaGlobal" {
  usecase "Consultar oportunidades" as UC01
  usecase "Verificar elegibilidade inicial" as UC02
  usecase "Registrar candidatura" as UC03
  usecase "Acompanhar candidatura" as UC04
  usecase "Consultar recursos de preparação" as UC05
  usecase "Gerenciar oportunidades" as UC06
  usecase "Gerenciar convênios e bolsas" as UC07
  usecase "Analisar candidaturas" as UC08
  usecase "Gerenciar notificações" as UC09
  usecase "Consultar relatórios gerenciais" as UC10
  usecase "Compartilhar relatos e participar de mentoria" as UC11
  usecase "Participar de atividades colaborativas" as UC12
  usecase "Consultar recursos de integração" as UC13
  usecase "Gerenciar usuários e permissões" as UC14
}

Estudante --> UC01
Estudante --> UC02
Estudante --> UC03
Estudante --> UC04
Estudante --> UC05
Estudante --> UC11
Estudante --> UC12
NEI --> UC06
NEI --> UC07
NEI --> UC08
NEI --> UC09
NEI --> UC10
Coordenador --> UC08
Professor --> UC12
Incoming --> UC13
Incoming --> UC12
Alumni --> UC11
Alumni --> UC12
Admin --> UC14

@enduml

@startuml
skinparam componentStyle rectangle
skinparam shadowing false

package "ConectaGlobal" {
  [Interface Web/Mobile] as UI
  [Autenticação e Autorização] as AUTH
  [Serviço de Oportunidades] as OPORT
  [Serviço de Convênios e Bolsas] as CONV
  [Serviço de Elegibilidade] as ELEG
  [Serviço de Candidaturas] as CAND
  [Gestão de Documentos] as DOC
  [Serviço de Notificações] as NOTIF
  [Relatórios Gerenciais] as REL
  [Preparação e Conteúdos] as PREP
  [Módulo Colaborativo e Pós-intercâmbio] as COL
  database "Banco de Dados" as DB
}

UI --> AUTH
UI --> OPORT
UI --> ELEG
UI --> CAND
UI --> PREP
UI --> COL
OPORT --> CONV
CAND --> ELEG
CAND --> DOC
CAND --> NOTIF
CAND --> REL
OPORT --> DB
CONV --> DB
ELEG --> DB
CAND --> DB
DOC --> DB
NOTIF --> DB
REL --> DB
PREP --> DB
COL --> DB
@enduml

@startuml
skinparam shadowing false

node "Dispositivo do usuário\n(Navegador / Aplicativo)" as CLIENT {
  artifact "Interface ConectaGlobal"
}

node "Ambiente de aplicação proposto" as APP {
  artifact "Aplicação Web"
  artifact "API / Serviços de negócio"
}

database "Servidor de banco de dados proposto" as DB

CLIENT --> APP : HTTPS (proposto)
APP --> DB : conexão segura (proposta)
@enduml
